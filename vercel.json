{
    "functions": {
        "app/api/chat/route.ts": {
            "memory": 512,
            "maxDuration": 400
        },
        "app/api/**/route.ts": {
            "memory": 512,
            "maxDuration": 10
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "next-ai-draw-io.vercel.app" }],
            "destination": "https://next-ai-drawio.jiang.jp/:path*",
            "permanent": true
        }
    ]
}
